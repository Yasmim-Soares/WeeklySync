<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:background="#FFFFFF"
    android:elevation="2dp">

    <CheckBox
        android:id="@+id/checkTarefa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#2D6A4F" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/txtTituloTarefa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome da Tarefa"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1B4332" />

        <TextView
            android:id="@+id/txtDiaTarefa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Segunda-feira"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#722F37" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnDeletarTarefa"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Excluir tarefa"
        app:tint="#722F37" />

</LinearLayout>